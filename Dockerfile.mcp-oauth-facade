FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine3.24@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
COPY cmd/mcp-oauth-facade ./cmd/mcp-oauth-facade
COPY internal/mcpoauth ./internal/mcpoauth

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/mcp-oauth-facade ./cmd/mcp-oauth-facade

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 65532 geul \
    && adduser -S -D -H -u 65532 -G geul geul

COPY --from=builder /out/mcp-oauth-facade /usr/local/bin/mcp-oauth-facade

USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/mcp-oauth-facade"]
