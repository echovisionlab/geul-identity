+// Copyright © 2026 Ory Corp
+// SPDX-License-Identifier: Apache-2.0
+
+package oidc_test
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/hashicorp/go-retryablehttp"
+	"github.com/jarcoal/httpmock"
+	"github.com/ory/kratos/pkg"
+	"github.com/ory/kratos/selfservice/strategy/oidc"
+	"github.com/ory/kratos/x"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+	"golang.org/x/oauth2/github"
+)
+
+func TestGeulGitHubProviderContract(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		app           bool
+		scope         string
+		emails        string
+		email         string
+		verified      bool
+		emailRequests int
+	}{
+		{name: "github primary verified email", scope: "user:email", emails: `[{"email":"other@example.com","primary":false,"verified":false},{"email":"primary@example.com","primary":true,"verified":true}]`, email: "primary@example.com", verified: true, emailRequests: 1},
+		{name: "github without email scope", scope: "read:user"},
+		{name: "github no primary preserves empty email", scope: "user:email", emails: `[{"email":"other@example.com","primary":false,"verified":true}]`, emailRequests: 1},
+		{name: "github app primary verified email", app: true, emails: `[{"email":"primary@example.com","primary":true,"verified":true},{"email":"other@example.com","primary":false,"verified":false}]`, email: "primary@example.com", verified: true, emailRequests: 1},
+		{name: "github app last email fallback", app: true, emails: `[{"email":"other@example.com","primary":false,"verified":false},{"email":"last@example.com","primary":false,"verified":true}]`, email: "last@example.com", verified: true, emailRequests: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, base := pkg.NewFastRegistryWithMocks(t)
+			reg := &mockRegistry{base, retryablehttp.NewClient()}
+			httpmock.ActivateNonDefault(reg.cl.HTTPClient)
+			t.Cleanup(httpmock.DeactivateAndReset)
+			httpmock.RegisterResponder("GET", "https://api.github.com/user", func(req *http.Request) (*http.Response, error) {
+				assert.Contains(t, req.Header.Get("Authorization"), "contract-token")
+				return httpmock.NewJsonResponse(200, map[string]interface{}{"id": 12345, "name": "Example Name", "login": "example", "blog": "https://example.com", "avatar_url": "https://example.com/avatar", "html_url": "https://github.com/example", "updated_at": "2026-10-01T12:00:00Z"})
+			})
+			httpmock.RegisterResponder("GET", "https://api.github.com/user/emails", httpmock.NewStringResponder(200, tc.emails))
+			conf := &oidc.Configuration{ID: "github", Scope: []string{tc.scope}}
+			var provider oidc.Provider = oidc.NewProviderGitHub(conf, reg)
+			if tc.app {
+				provider = oidc.NewProviderGitHubApp(conf, reg)
+			}
+			token := (&oauth2.Token{AccessToken: "contract-token", Expiry: time.Now().Add(time.Hour)}).WithExtra(map[string]interface{}{"scope": tc.scope})
+			claims, err := provider.(oidc.OAuth2Provider).Claims(context.Background(), token, url.Values{})
+			require.NoError(t, err)
+			updated, err := time.Parse(time.RFC3339, "2026-10-01T12:00:00Z")
+			require.NoError(t, err)
+			assert.Equal(t, &oidc.Claims{Subject: "12345", Issuer: github.Endpoint.TokenURL, Name: "Example Name", Nickname: "example", Website: "https://example.com", Picture: "https://example.com/avatar", Profile: "https://github.com/example", UpdatedAt: updated.Unix(), Email: tc.email, EmailVerified: x.ConvertibleBoolean(tc.verified)}, claims)
+			assert.Equal(t, 1, httpmock.GetCallCountInfo()["GET https://api.github.com/user"])
+			assert.Equal(t, tc.emailRequests, httpmock.GetCallCountInfo()["GET https://api.github.com/user/emails"])
+		})
+	}
+	t.Run("github missing configured scope", func(t *testing.T) {
+		_, reg := pkg.NewFastRegistryWithMocks(t)
+		provider := oidc.NewProviderGitHub(&oidc.Configuration{Scope: []string{"user:email"}}, reg)
+		token := (&oauth2.Token{AccessToken: "contract-token"}).WithExtra(map[string]interface{}{"scope": "read:user"})
+		_, err := provider.(oidc.OAuth2Provider).Claims(context.Background(), token, url.Values{})
+		assert.ErrorIs(t, err, oidc.ErrScopeMissing)
+	})
+}
