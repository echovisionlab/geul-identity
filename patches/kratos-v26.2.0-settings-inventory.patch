+package passkey_test
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/gofrs/uuid"
+	"github.com/ory/kratos/driver/config"
+	"github.com/ory/kratos/identity"
+	"github.com/ory/kratos/pkg/testhelpers"
+	"github.com/ory/kratos/ui/node"
+	"github.com/ory/kratos/x"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestGeulPasskeySettingsWebhookContract(t *testing.T) {
+	for _, stock := range []bool{true, false} {
+		name := "corrected-contract"
+		if stock {
+			name = "stock-contract-reproduces-failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			fix := newSettingsFixture(t)
+			var calls atomic.Int32
+			deliveries := make(chan []byte, 8)
+			callback := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var body json.RawMessage
+				if r.Header.Get("X-Internal-Service") != "contract-test-secret" {
+					w.WriteHeader(401)
+					return
+				}
+				if json.NewDecoder(r.Body).Decode(&body) != nil {
+					w.WriteHeader(400)
+					return
+				}
+				calls.Add(1)
+				deliveries <- body
+				if !gjson.GetBytes(body, "credentials_present").Bool() || !gjson.GetBytes(body, "previous_credentials_present").Bool() {
+					w.WriteHeader(500)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{}`))
+			}))
+			t.Cleanup(callback.Close)
+			template := `function(ctx) { credentials_present: std.objectHas(ctx.identity,'credentials'), previous_credentials_present: std.objectHas(ctx.session.identity,'credentials') }`
+			if !stock {
+				actual, err := os.ReadFile(os.Getenv("GEUL_CREDENTIAL_SETTINGS_TEMPLATE"))
+				require.NoError(t, err, "test must use the identity repository's actual settings template")
+				template = string(actual)
+			}
+			file := filepath.Join(t.TempDir(), "settings.jsonnet")
+			require.NoError(t, os.WriteFile(file, []byte(template), 0600))
+			hooks := []config.SelfServiceHook{}
+			for _, parse := range []bool{true, false} {
+				conf, err := json.Marshal(map[string]any{"url": callback.URL, "method": "POST", "body": "file://" + file, "auth": map[string]any{"type": "api_key", "config": map[string]any{"name": "X-Internal-Service", "value": "contract-test-secret", "in": "header"}}, "response": map[string]any{"ignore": false, "parse": parse}})
+				require.NoError(t, err)
+				hooks = append(hooks, config.SelfServiceHook{Name: "web_hook", Config: conf})
+			}
+			fix.conf.MustSet(t.Context(), "selfservice.flows.settings.after.passkey.hooks", hooks)
+			var id identity.Identity
+			require.NoError(t, json.Unmarshal(settingsFixtureSuccessIdentity, &id))
+			id.NID = x.NewUUID()
+			_ = fix.reg.PrivilegedIdentityPool().DeleteIdentity(t.Context(), id.ID)
+			client := testhelpers.NewHTTPClientWithIdentitySessionCookie(t.Context(), t, fix.reg, &id)
+			f := testhelpers.InitializeSettingsFlowViaBrowser(t, client, true, fix.publicTS)
+			interim, err := fix.reg.SettingsFlowPersister().GetSettingsFlow(t.Context(), uuid.FromStringOrNil(f.Id))
+			require.NoError(t, err)
+			interim.InternalContext = settingsFixtureSuccessInternalContext
+			require.NoError(t, fix.reg.SettingsFlowPersister().UpdateSettingsFlow(t.Context(), interim))
+			values := testhelpers.SDKFormFieldsToURLValues(f.Ui.Nodes)
+			values.Set("method", "passkey")
+			values.Set(node.PasskeySettingsRegister, string(settingsFixtureSuccessResponse))
+			body, response := testhelpers.SettingsMakeRequest(t, false, true, f, client, testhelpers.EncodeFormAsJSON(t, true, values))
+			stored, err := fix.reg.PrivilegedIdentityPool().GetIdentityConfidential(t.Context(), id.ID)
+			require.NoError(t, err)
+			if stock {
+				require.GreaterOrEqual(t, calls.Load(), int32(1))
+				require.NotContains(t, stored.Credentials, identity.CredentialsTypePasskey, "failed pre-hook must not persist the key")
+				require.NotEqual(t, "success", gjson.Get(body, "state").String())
+				return
+			}
+			require.Equal(t, http.StatusOK, response.StatusCode, body)
+			require.Equal(t, "success", gjson.Get(body, "state").String(), body)
+			require.Equal(t, int32(2), calls.Load(), "exactly one pre and one post callback")
+			first, second := <-deliveries, <-deliveries
+			for _, delivery := range [][]byte{first, second} {
+				require.True(t, gjson.GetBytes(delivery, "credentials_present").Bool())
+				require.False(t, gjson.GetBytes(delivery, "previous_credentials.passkey").Exists())
+				require.Equal(t, int64(1), gjson.GetBytes(delivery, "credentials.passkey.config.credentials.#").Int())
+				require.False(t, gjson.GetBytes(delivery, "credentials.passkey.config.credentials.0.public_key").Exists())
+			}
+			require.JSONEq(t, string(first), string(second), "pre and post must describe the same exact mutation")
+			require.Contains(t, stored.Credentials, identity.CredentialsTypePasskey)
+			require.Equal(t, gjson.GetBytes(stored.Credentials[identity.CredentialsTypePasskey].Config, "credentials.0.id").String(), gjson.GetBytes(second, "credentials.passkey.config.credentials.0.id").String())
+		})
+	}
+}
