+// Copyright © 2026 Echovision Lab
+// SPDX-License-Identifier: Apache-2.0
+
+package settings
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"slices"
+
+	"github.com/ory/kratos/identity"
+)
+
+type credentialChangeKey struct{}
+
+// CredentialChange contains only the inventory needed by an authenticated
+// settings-policy webhook. It is request-local and is never part of a public
+// identity, flow, or session response. Passwords, tokens, keys and claims stay
+// behind Kratos' existing confidential identity boundary.
+type CredentialChange struct {
+	Previous map[identity.CredentialsType]CredentialSummary `json:"previous_credentials"`
+	Proposed map[identity.CredentialsType]CredentialSummary `json:"credentials"`
+}
+
+type CredentialSummary struct {
+	Type        identity.CredentialsType `json:"type"`
+	Identifiers []string                 `json:"identifiers"`
+	Config      json.RawMessage          `json:"config,omitempty"`
+}
+
+func CredentialChangeFromContext(ctx context.Context) *CredentialChange {
+	change, _ := ctx.Value(credentialChangeKey{}).(*CredentialChange)
+	return change
+}
+
+func withCredentialChange(ctx context.Context, previous, proposed *identity.Identity) (context.Context, error) {
+	before, err := credentialSummary(previous)
+	if err != nil {
+		return ctx, err
+	}
+	after, err := credentialSummary(proposed)
+	if err != nil {
+		return ctx, err
+	}
+	return context.WithValue(ctx, credentialChangeKey{}, &CredentialChange{Previous: before, Proposed: after}), nil
+}
+
+func credentialSummary(id *identity.Identity) (map[identity.CredentialsType]CredentialSummary, error) {
+	if id == nil {
+		return nil, fmt.Errorf("settings credential identity is missing")
+	}
+	out := make(map[identity.CredentialsType]CredentialSummary)
+	for _, kind := range []identity.CredentialsType{identity.CredentialsTypeCodeAuth, identity.CredentialsTypeOIDC, identity.CredentialsTypePasskey} {
+		credential, ok := id.Credentials[kind]
+		if !ok {
+			continue
+		}
+		summary := CredentialSummary{Type: kind, Identifiers: slices.Clone(credential.Identifiers)}
+		if kind == identity.CredentialsTypePasskey {
+			var config struct {
+				Credentials []struct {
+					ID string `json:"id"`
+				} `json:"credentials"`
+			}
+			if err := json.Unmarshal(credential.Config, &config); err != nil {
+				return nil, fmt.Errorf("settings passkey inventory is invalid: %w", err)
+			}
+			for _, key := range config.Credentials {
+				if key.ID == "" {
+					return nil, fmt.Errorf("settings passkey identifier is missing")
+				}
+			}
+			encoded, err := json.Marshal(config)
+			if err != nil {
+				return nil, err
+			}
+			summary.Config = encoded
+		}
+		out[kind] = summary
+	}
+	return out, nil
+}
