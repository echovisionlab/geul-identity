+package settings
+
+import (
+	"encoding/json"
+	"github.com/ory/kratos/identity"
+	"github.com/ory/x/sqlxx"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestGeulCredentialInventoryDoesNotExposeSecrets(t *testing.T) {
+	old := &identity.Identity{Credentials: map[identity.CredentialsType]identity.Credentials{
+		identity.CredentialsTypePassword: {Config: sqlxx.JSONRawMessage(`{"hashed_password":"password-secret"}`)},
+		identity.CredentialsTypeCodeAuth: {Identifiers: []string{"test@example.test"}, Config: sqlxx.JSONRawMessage(`{"code":"otp-secret"}`)},
+		identity.CredentialsTypeOIDC:     {Identifiers: []string{"google:subject"}, Config: sqlxx.JSONRawMessage(`{"providers":[{"initial_access_token":"access-secret","initial_id_token":"id-secret"}]}`)},
+		identity.CredentialsTypePasskey:  {Config: sqlxx.JSONRawMessage(`{"credentials":[{"id":"a2V5LTE=","public_key":"key-secret","display_name":"private-device"}]}`)},
+	}}
+	next := &identity.Identity{Credentials: map[identity.CredentialsType]identity.Credentials{
+		identity.CredentialsTypePasskey: {Config: sqlxx.JSONRawMessage(`{"credentials":[{"id":"a2V5LTE="},{"id":"a2V5LTI="}]}`)},
+	}}
+	ctx, err := withCredentialChange(t.Context(), old, next)
+	require.NoError(t, err)
+	change := CredentialChangeFromContext(ctx)
+	require.NotNil(t, change)
+	raw, err := json.Marshal(change)
+	require.NoError(t, err)
+	for _, secret := range []string{"password-secret", "otp-secret", "access-secret", "id-secret", "key-secret", "private-device"} {
+		require.NotContains(t, string(raw), secret)
+	}
+	require.Contains(t, string(raw), "google:subject")
+	require.Contains(t, string(raw), "a2V5LTI=")
+	require.NotContains(t, change.Previous, identity.CredentialsTypePassword)
+	// Later identity/session changes cannot rewrite the event's before image.
+	old.Credentials[identity.CredentialsTypeOIDC].Identifiers[0] = "changed"
+	delete(next.Credentials, identity.CredentialsTypePasskey)
+	require.Equal(t, []string{"google:subject"}, change.Previous[identity.CredentialsTypeOIDC].Identifiers)
+	require.Contains(t, change.Proposed, identity.CredentialsTypePasskey)
+	require.Nil(t, CredentialChangeFromContext(t.Context()))
+}
+
+func TestGeulCredentialInventoryRejectsMalformedPasskeys(t *testing.T) {
+	for _, config := range []string{`{`, `{"credentials":[{}]}`} {
+		_, err := credentialSummary(&identity.Identity{Credentials: map[identity.CredentialsType]identity.Credentials{identity.CredentialsTypePasskey: {Config: sqlxx.JSONRawMessage(config)}}})
+		require.Error(t, err)
+	}
+}
