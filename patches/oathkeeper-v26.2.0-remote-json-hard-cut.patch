diff --git a/pipeline/errors/error_www_authenticate.go b/pipeline/errors/error_www_authenticate.go
--- a/pipeline/errors/error_www_authenticate.go
+++ b/pipeline/errors/error_www_authenticate.go
@@ -18 +18,3 @@
-		Realm string `json:"realm"`
+		Realm            string `json:"realm"`
+		ResourceMetadata string `json:"resource_metadata"`
+		Scope            string `json:"scope"`
@@ -35 +37 @@
-func (a *ErrorWWWAuthenticate) Handle(w http.ResponseWriter, r *http.Request, config json.RawMessage, _ pipeline.Rule, _ error) error {
+func (a *ErrorWWWAuthenticate) Handle(w http.ResponseWriter, r *http.Request, config json.RawMessage, _ pipeline.Rule, handleErr error) error {
@@ -41 +43,13 @@
-	w.Header().Set("WWW-Authenticate", fmt.Sprintf(`Basic realm=%s`, c.Realm))
+	if c.ResourceMetadata != "" {
+		if !pipeline.IsAuthenticationError(handleErr) {
+			a.d.Writer().WriteError(w, r, handleErr)
+			return nil
+		}
+		challenge := fmt.Sprintf(`Bearer resource_metadata="%s"`, c.ResourceMetadata)
+		if c.Scope != "" {
+			challenge += fmt.Sprintf(`, scope="%s"`, c.Scope)
+		}
+		w.Header().Set("WWW-Authenticate", challenge)
+	} else {
+		w.Header().Set("WWW-Authenticate", fmt.Sprintf(`Basic realm=%s`, c.Realm))
+	}
diff --git a/pipeline/error.go b/pipeline/error.go
--- a/pipeline/error.go
+++ b/pipeline/error.go
@@ -10,0 +11,21 @@ var (
+
+type authenticationError struct {
+	err error
+}
+
+func (e *authenticationError) Error() string {
+	return e.err.Error()
+}
+
+func (e *authenticationError) Unwrap() error {
+	return e.err
+}
+
+func MarkAuthenticationError(err error) error {
+	return &authenticationError{err: err}
+}
+
+func IsAuthenticationError(err error) bool {
+	var target *authenticationError
+	return errors.As(err, &target)
+}
